# Copia este archivo como `.env` y ajusta los valores si lo necesitas.
# Si no creas `.env`, el proyecto funciona con valores por defecto (SQLite + DEBUG=True).

# Clave secreta de Django (genera una propia en producción)
# DJANGO_SECRET_KEY=clave-secreta-super-segura

# Modo debug: True/False
# DJANGO_DEBUG=True

# Hosts permitidos separados por coma (por defecto todos en desarrollo)
# DJANGO_ALLOWED_HOSTS=*

# Base de datos. Por defecto usa SQLite (db.sqlite3), sin configuración extra.
# Para PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=coursehub
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432

# Orígenes CORS permitidos (frontend) separados por coma
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Credenciales del usuario administrador creado por `seed_data`
# SEED_ADMIN_EMAIL=admin@espol.edu.ec
# SEED_ADMIN_PASSWORD=AdminEspol2026!
# SEED_ADMIN_PSEUDONIMO=Admin_CourseHub

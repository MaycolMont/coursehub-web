# Copia este archivo como `.env` y ajusta los valores si lo necesitas.
# Si no creas `.env`, el proyecto funciona con valores por defecto (SQLite + DEBUG=True).

# Clave secreta de Django (genera una propia en producción)
# DJANGO_SECRET_KEY=clave-secreta-super-segura

# Modo debug: True/False (en producción usa False)
# DJANGO_DEBUG=True

# Hosts permitidos separados por coma.
# En producción (Render) incluye el dominio del servicio, p. ej.:
# DJANGO_ALLOWED_HOSTS=mi-app.onrender.com
DJANGO_ALLOWED_HOSTS=*

# Base de datos. Por defecto usa SQLite (db.sqlite3), sin configuración extra.
# En producción (Render + Supabase Postgres):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=tu_password
# DB_HOST=aws-0-us-east-1.pooler.supabase.com
# DB_PORT=6543

# CORS: con True cualquier origen puede consumir la API. Con False solo se
# permiten los orígenes de CORS_ALLOWED_ORIGINS.
# CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Credenciales del usuario administrador creado por `seed_data`
# SEED_ADMIN_EMAIL=admin@espol.edu.ec
# SEED_ADMIN_PASSWORD=AdminEspol2026!
# SEED_ADMIN_PSEUDONIMO=Admin_CourseHub

# Almacenamiento de archivos en Supabase Storage (API S3-compatible).
# Requerido para los recursos. Las claves S3 se obtienen en
# Supabase Dashboard -> Storage -> Bucket 'recursos_academicos' -> S3 settings.
# SUPABASE_PUBLIC_URL: https://<project-ref>.supabase.co
# SUPABASE_S3_ENDPOINT: https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_BUCKET=recursos_academicos
# SUPABASE_PUBLIC_URL=https://<project-ref>.supabase.co
# SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# SUPABASE_S3_ACCESS_KEY=tu-s3-access-key
# SUPABASE_S3_SECRET_KEY=tu-s3-secret-key

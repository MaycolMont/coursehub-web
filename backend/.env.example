# Copia este archivo como `.env` y ajusta los valores si lo necesitas.
# Si no creas `.env`, el proyecto funciona con valores por defecto (SQLite + DEBUG=True).

# Clave secreta de Django (genera una propia en producción)
# DJANGO_SECRET_KEY=clave-secreta-super-segura

# Modo debug: True/False (en producción usa False)
# DJANGO_DEBUG=True

# Hosts permitidos separados por coma.
# En AlwaysData incluye el dominio de tu app, p. ej.:
# DJANGO_ALLOWED_HOSTS=tuusuario.alwaysdata.net,www.tuusuario.alwaysdata.net
DJANGO_ALLOWED_HOSTS=*

# Base de datos. Por defecto usa SQLite (db.sqlite3), sin configuración extra.
# Para PostgreSQL:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=coursehub
# DB_USER=postgres
# DB_PASSWORD=tu_password
# DB_HOST=localhost
# DB_PORT=5432

# Para MySQL / MariaDB (el hosting AlwaysData usa MySQL):
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=tuusuario_coursehub
# DB_USER=tuusuario
# DB_PASSWORD=tu_password
# DB_HOST=mysql-tuusuario.alwaysdata.net
# DB_PORT=3306

# CORS: con True cualquier origen puede consumir la API (recomendado para el
# frontend publicado en InfinityFree). Con False solo se permiten los orígenes
# de CORS_ALLOWED_ORIGINS.
# CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://coursehub.infinityfreeapp.com

# Credenciales del usuario administrador creado por `seed_data`
# SEED_ADMIN_EMAIL=admin@espol.edu.ec
# SEED_ADMIN_PASSWORD=AdminEspol2026!
# SEED_ADMIN_PSEUDONIMO=Admin_CourseHub
